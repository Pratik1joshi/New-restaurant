# Required for cPanel production
NODE_ENV=production
APP_URL=https://pos.example.com
NEXT_PUBLIC_SITE_URL=https://pos.example.com
DATABASE_URL=postgresql://DBUSER:URL_ENCODED_PASSWORD@localhost:5432/DBNAME
PGSSL=false
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=10000
HOSTNAME=0.0.0.0
UPLOADS_DIR=/home/CPANEL_USER/pos-uploads
IMAGES_PATH=/uploads
FORCE_SECURE_COOKIES=1
SESSION_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret

# Recommended operational settings
CASHIER_CLOSING_CUTOFF=20:30
LOG_LEVEL=info
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC=8

# Used only by the optional minimal database seed command
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-running-db-seed
ADMIN_FULL_NAME=Restaurant Admin
